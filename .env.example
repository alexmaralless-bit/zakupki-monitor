# Копия этого файла -> .env (в git не попадает)
ZM_DB_PATH=data/zakupki.db
ZM_CA_BUNDLE=certs/ru-ca.pem
ZM_PAUSE_MIN=2
ZM_PAUSE_MAX=4
ZM_MAX_RETRIES=3
ZM_DEFAULT_MAX_PAGES=5

# Веб-интерфейс слушает только 127.0.0.1
ZM_WEB_PORT=8765

# ИИ-оценка: yandex | gigachat | openai | local (демо-провайдер "demo" только для скриншотов)
# Провайдера можно сменить и в веб-интерфейсе (Настройки). Ключи хранятся только здесь.
ZM_AI_PROVIDER=yandex
ZM_YANDEX_API_KEY=
ZM_YANDEX_FOLDER_ID=
ZM_YANDEX_MODEL=yandexgpt
ZM_GIGACHAT_AUTH_KEY=
ZM_GIGACHAT_SCOPE=GIGACHAT_API_PERS
ZM_GIGACHAT_MODEL=GigaChat
ZM_OPENAI_API_KEY=
ZM_OPENAI_MODEL=gpt-4o-mini
ZM_OPENAI_BASE_URL=https://api.openai.com/v1
# Локальная модель с OpenAI-совместимым API (Ollama, LM Studio, vLLM)
ZM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
ZM_LOCAL_MODEL=qwen2.5:7b
ZM_LOCAL_API_KEY=
# Прокси для ИИ и Telegram (по желанию; системные переменные прокси не используются)
ZM_PROXY=
